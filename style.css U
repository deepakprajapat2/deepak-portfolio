:root {
  --navy: #0f2c59;
  --navy-deep: #0a1f40;
  --blue: #1b4f9c;
  --blue-soft: #e8eef8;
  --gold: #c9a227;
  --gold-soft: #f4e7b8;
  --white: #ffffff;
  --text: #1a2332;
  --muted: #4d5a6a;
  --border: #d7deea;
  --card: #ffffff;
  --shadow: 0 12px 30px rgba(15, 44, 89, 0.12);
  --header-bg: rgba(255, 255, 255, 0.92);
  --radius: 16px;
}

[data-theme="dark"] {
  --navy: #8eb4ff;
  --navy-deep: #dbe7ff;
  --blue: #6ea0ff;
  --blue-soft: #15233a;
  --gold: #e0c15a;
  --gold-soft: #3a3114;
  --white: #101826;
  --text: #eef3fb;
  --muted: #b7c2d3;
  --border: #2a3a55;
  --card: #162033;
  --shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
  --header-bg: rgba(16, 24, 38, 0.92);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 84px;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, Segoe UI, sans-serif;
  background: var(--white);
  color: var(--text);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: var(--blue);
}

.skip-link {
  position: absolute;
  left: 1rem;
  top: -4rem;
  background: var(--gold);
  color: var(--navy-deep);
  padding: 0.6rem 1rem;
  z-index: 1000;
}

.skip-link:focus {
  top: 1rem;
}

.container {
  width: min(1100px, calc(100% - 2rem));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--header-bg);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  min-height: 72px;
}

.logo {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--navy);
  text-decoration: none;
  margin-right: auto;
}

.logo span {
  color: var(--gold);
}

.site-nav ul {
  display: flex;
  gap: 1.1rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.site-nav a {
  color: var(--text);
  text-decoration: none;
  font-weight: 500;
  padding: 0.35rem 0;
  border-bottom: 2px solid transparent;
}

.site-nav a:hover,
.site-nav a.active {
  color: var(--blue);
  border-bottom-color: var(--gold);
}

.nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 10px;
  cursor: pointer;
}

.nav-toggle span {
  display: block;
  height: 2px;
  width: 18px;
  margin: 0 auto;
  background: var(--navy);
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  border-radius: 999px;
  padding: 0.45rem 0.8rem;
  cursor: pointer;
  font-weight: 600;
}

.hero {
  padding: 4rem 0 3.5rem;
  background:
    linear-gradient(180deg, var(--blue-soft) 0%, transparent 70%);
}

.hero-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 3rem;
  align-items: center;
}

.profile-photo {
  position: relative;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  overflow: hidden;
  border: 5px solid var(--gold);
  box-shadow: var(--shadow);
  background: linear-gradient(160deg, var(--navy) 0%, var(--blue) 100%);
}

.profile-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-photo img.is-missing {
  display: none;
}

.profile-initials {
  display: none;
  position: absolute;
  inset: 0;
  align-items: center;
  justify-content: center;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 5rem;
  font-weight: 700;
  color: var(--gold-soft);
}

.profile-photo:has(img.is-missing) .profile-initials,
.profile-photo.no-photo .profile-initials {
  display: flex;
}

.photo-hint {
  margin: 0.85rem 0 0;
  font-size: 0.85rem;
  color: var(--muted);
  text-align: center;
}

.eyebrow {
  color: var(--blue);
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 0 0 0.5rem;
}

.hero h1 {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  margin: 0 0 0.4rem;
  color: var(--navy);
}

.college {
  margin: 0 0 1rem;
  color: var(--gold);
  font-weight: 600;
}

.lead {
  margin: 0 0 1.5rem;
  max-width: 58ch;
  color: var(--muted);
}

.hero-actions,
.contact-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  border-radius: 999px;
  padding: 0.75rem 1.2rem;
  font-weight: 600;
  border: 2px solid transparent;
}

.btn-primary {
  background: var(--navy-deep);
  color: #fff;
}

[data-theme="dark"] .btn-primary {
  background: var(--blue);
  color: #101826;
}

.btn-github {
  background: var(--gold);
  color: #0a1f40;
}

.btn-outline {
  border-color: var(--navy);
  color: var(--navy);
}

.section {
  padding: 4rem 0;
}

.section-alt {
  background: var(--blue-soft);
}

.section h2 {
  font-family: "Playfair Display", Georgia, serif;
  color: var(--navy);
  margin: 0 0 1rem;
  font-size: 2rem;
}

.section-intro {
  color: var(--muted);
  margin: 0 0 1.5rem;
}

.about-list,
.contact-list {
  padding-left: 1.1rem;
}

.about-list li,
.contact-list li {
  margin-bottom: 0.45rem;
}

.skill-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 0.85rem;
  margin: 0;
  padding: 0;
}

.skill-grid li {
  background: var(--card);
  border: 1px solid var(--border);
  border-top: 4px solid var(--gold);
  border-radius: 12px;
  padding: 0.9rem 1rem;
  font-weight: 600;
  box-shadow: var(--shadow);
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.2rem;
}

.project-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  box-shadow: var(--shadow);
}

.project-card h3 {
  margin: 0 0 0.6rem;
  color: var(--navy);
}

.tech,
.repo-pending {
  color: var(--muted);
  font-size: 0.95rem;
}

.repo-link {
  display: inline-block;
  margin-top: 0.4rem;
  font-weight: 600;
  color: var(--blue);
}

.site-footer {
  border-top: 3px solid var(--gold);
  background: var(--navy-deep);
  color: #fff;
  padding: 1.4rem 0;
  text-align: center;
}

[data-theme="dark"] .site-footer {
  background: #0b1220;
}

@media (max-width: 800px) {
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  .hero-actions {
    justify-content: center;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .site-nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 72px;
    z-index: 60;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 0.75rem 1rem 1rem;
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    flex-direction: column;
    gap: 0.4rem;
  }
}

@media (max-width: 520px) {
  .profile-photo {
    width: 210px;
    height: 210px;
  }

  .theme-label {
    display: none;
  }
}
